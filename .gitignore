# dependências instaladas — a Vercel resolve pelo package-lock.json
node_modules/

# variáveis locais; as de verdade ficam no painel da Vercel
.env
.env.local
.env*.local

# saída de build e cache da Vercel
.vercel
.next
dist/

# cópia local dos dados do OpenBible, baixada pelo gerador do mapa;
# são 15 MB e o que importa versionar é a saída, não a entrada
ferramentas/.cache-openbible/

# capturas que as suítes salvam para inspeção; são saída, não fonte
testes/*.png

# lixo de sistema
.DS_Store
Thumbs.db
*.log
